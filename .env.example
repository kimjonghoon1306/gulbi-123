# Supabase
# Supabase 대시보드 → Settings → API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=여기에_Project_URL_붙여넣기
NEXT_PUBLIC_SUPABASE_ANON_KEY=여기에_Publishable_key_붙여넣기
# 서버 전용(Service Role) 키 — 가상계좌 입금 웹훅이 로그인 없이 주문상태 변경할 때 필요.
# Supabase 대시보드 → Settings → API → service_role 키. ⚠️ 절대 NEXT_PUBLIC_ 아님(브라우저 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=여기에_service_role_key_붙여넣기

# AI 키 암호화용 비밀키 (필수!) — 관리자가 입력한 OpenAI/Gemini 키를 DB에 암호화 저장할 때 사용.
# 미설정 시 키 저장이 "암호화 실패"로 안 됩니다. 64자 hex(=32바이트). 생성: openssl rand -hex 32
# ⚠️ 한 번 정하면 바꾸지 마세요(바꾸면 기존 저장된 키 복호화 불가).
API_KEY_ENCRYPTION_SECRET=64자_hex_문자열

# 토스페이먼츠 (결제) — developers.tosspayments.com
# 미설정 시 테스트 키로 동작. 가맹 심사 통과 후 실 키로 교체하세요.
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_Z1aOwX7K8m4zBKZLZXpmryQxzvNP
TOSS_SECRET_KEY=test_sk_pP2YxJ4K87Z02Z904ZDJrRGZwXLO

# 팝빌 (전자세금계산서·현금영수증 자동발행) — popbill.com
# 미설정 시 발행 버튼이 안내 에러를 냅니다. 테스트는 POPBILL_IS_TEST=true(테스트베드)로 먼저.
POPBILL_LINK_ID=팝빌_연동회원_LinkID
POPBILL_SECRET_KEY=팝빌_SecretKey
POPBILL_IS_TEST=true
POPBILL_CORP_NUM=공급자_사업자번호_10자리_숫자만
POPBILL_SELLER_NAME=상호
POPBILL_SELLER_CEO=대표자명
POPBILL_SELLER_ADDR=사업장주소
POPBILL_SELLER_BIZTYPE=업태
POPBILL_SELLER_BIZCLASS=종목
POPBILL_SELLER_TEL=대표전화
POPBILL_SELLER_EMAIL=발행담당_이메일

# 통합 배송추적 (스마트택배 SweetTracker) — https://tracking.sweettracker.co.kr 무료 발급
# 미설정 시 배송조회가 안내 메시지를 냅니다.
SWEETTRACKER_API_KEY=스마트택배_API_KEY
